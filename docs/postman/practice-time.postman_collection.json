{
  "info": {
    "_postman_id": "81ab5b8d-268e-4fb5-b414-1309725c466f",
    "name": "Practice Time API",
    "description": "Requests for the API endpoints currently implemented in the Practice Time NestJS application. Run Auth > Sign up (once) and Auth > Login first. Login stores the bearer token automatically. Responses are wrapped as `{ success: true, data: ... }`, except paginated responses, which expose `data`, `meta`, and `links` beside `success`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "owner@example.com"
    },
    {
      "key": "password",
      "value": "PracticeTime1!"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "assignmentItemId",
      "value": ""
    },
    {
      "key": "resourceId",
      "value": ""
    },
    {
      "key": "practiceSessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Practice\",\n  \"lastName\": \"Owner\",\n  \"email\": \"{{email}}\",\n  \"dateOfBirth\": \"1990-01-01T00:00:00.000Z\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Creates an account. Change the email variable before rerunning if the account already exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('userId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Authenticates the user and stores `data.access_token` as the collection's `accessToken`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', body.data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the authenticated principal currently attached by the JWT strategy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('userId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Application",
      "item": [
        {
          "name": "Get health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Public operational health check."
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student",
          "request": {
            "description": "In Body > form-data, select an actual local file for the file row. Do not manually set Content-Type; Postman adds the multipart boundary.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Student\",\n  \"dateOfBirth\": \"2014-05-15T00:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('studentId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/students?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["students"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "Alex",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "id:DESC",
                  "disabled": true
                }
              ]
            },
            "description": "Returns only active students owned by the authenticated user."
          }
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Update student",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alexandra\"\n}"
            },
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Deactivate student",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/students/{{studentId}}",
            "description": "Soft-deactivates an owned student. Run this after assignment requests."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Authenticated self-service profile routes. The target user always comes from the bearer token; arbitrary user IDs are not accepted.",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"User\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Student assignments",
      "description": "Assignment CRUD scoped to the authenticated owner through the required studentId.",
      "item": [
        {
          "name": "Create assignment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"title\": \"Recital practice week\",\n  \"description\": \"Practice Amazing Grace and complete written theory.\",\n  \"startDate\": \"2026-06-15\",\n  \"endDate\": \"2026-06-21\",\n  \"notices\": [\n    {\n      \"title\": \"Year End Recital\",\n      \"occursAt\": \"2026-06-22T22:45:00.000Z\",\n      \"location\": \"Room 213\",\n      \"position\": 0\n    }\n  ],\n  \"sections\": [\n    {\n      \"title\": \"Repertoire\",\n      \"position\": 0,\n      \"items\": [\n        {\n          \"title\": \"Amazing Grace\",\n          \"instructions\": \"Practice the whole song, memorized.\",\n          \"completionMode\": \"practice_days\",\n          \"suggestedPracticeDays\": 5,\n          \"position\": 0,\n          \"resources\": [\n            {\n              \"kind\": \"youtube\",\n              \"displayName\": \"Performance guide\",\n              \"url\": \"https://www.youtube.com/watch?v=example\",\n              \"position\": 1\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"title\": \"Written Theory\",\n      \"position\": 1,\n      \"items\": [\n        {\n          \"title\": \"JR3 Unit 4 Test\",\n          \"completionMode\": \"one_time\",\n          \"dueAt\": \"2026-06-20T13:00:00.000Z\",\n          \"position\": 0,\n          \"resources\": [\n            {\n              \"kind\": \"external_link\",\n              \"displayName\": \"Open test\",\n              \"url\": \"https://example.com/jr3-unit-4\",\n              \"position\": 0\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/student-assignments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('assignmentId', body.data.id);",
                  "  if (body.data && body.data.sections && body.data.sections[0]) pm.collectionVariables.set('assignmentItemId', body.data.sections[0].items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List assignments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-assignments"
          }
        },
        {
          "name": "Get assignment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Update assignment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated recital practice week\"\n}"
            },
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Delete assignment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}"
          }
        }
      ]
    },
    {
      "name": "Practice sessions",
      "description": "Create, filter, correct, and delete free or assignment-item practice for owned students.",
      "item": [
        {
          "name": "Create item-linked session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"assignmentItemId\": \"{{assignmentItemId}}\",\n  \"durationSeconds\": 900,\n  \"practicedAt\": \"2026-08-13T18:00:00.000Z\",\n  \"note\": \"Scales and recital repertoire\"\n}"
            },
            "url": "{{baseUrl}}/practice-sessions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('practiceSessionId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List filtered sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/practice-sessions?studentId={{studentId}}&assignmentItemId={{assignmentItemId}}&practiceLocalDate=2026-08-13&page=1&limit=20"
          }
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/practice-sessions/{{practiceSessionId}}"
          }
        },
        {
          "name": "Correct session",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationSeconds\": 1200,\n  \"note\": \"Corrected duration\"\n}"
            },
            "url": "{{baseUrl}}/practice-sessions/{{practiceSessionId}}"
          }
        },
        {
          "name": "Get assignment practice summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}/practice-summary"
          }
        },
        {
          "name": "Delete session",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/practice-sessions/{{practiceSessionId}}"
          }
        }
      ]
    },
    {
      "name": "Assignment resources",
      "description": "Ownership-scoped private uploads, HTTPS links, metadata, signed reads, and removal.",
      "item": [
        {
          "name": "Upload private file",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                {
                  "key": "displayName",
                  "value": "Sheet music",
                  "type": "text"
                },
                { "key": "position", "value": "0", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/student-assignment-items/{{assignmentItemId}}/resources/upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('resourceId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create external link",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"external_link\",\n  \"displayName\": \"Theory test\",\n  \"url\": \"https://example.com/theory-test#instructions\",\n  \"position\": 2\n}"
            },
            "url": "{{baseUrl}}/student-assignment-items/{{assignmentItemId}}/resources/links"
          }
        },
        {
          "name": "List item resources",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-assignment-items/{{assignmentItemId}}/resources"
          }
        },
        {
          "name": "Get signed file URL",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assignment-resources/{{resourceId}}/access-url"
          }
        },
        {
          "name": "Delete resource",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/assignment-resources/{{resourceId}}"
          }
        }
      ]
    }
  ]
}
