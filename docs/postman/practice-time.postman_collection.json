{
  "info": {
    "_postman_id": "81ab5b8d-268e-4fb5-b414-1309725c466f",
    "name": "Practice Time API",
    "description": "Requests for the API endpoints currently implemented in the Practice Time NestJS application. Run Auth > Sign up (once) and Auth > Login first. Login stores the bearer token automatically. Responses are wrapped as `{ success: true, data: ... }`, except paginated responses, which expose `data`, `meta`, and `links` beside `success`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "owner@example.com"
    },
    {
      "key": "password",
      "value": "PracticeTime1!"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Practice\",\n  \"lastName\": \"Owner\",\n  \"email\": \"{{email}}\",\n  \"dateOfBirth\": \"1990-01-01T00:00:00.000Z\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Creates an account. Change the email variable before rerunning if the account already exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('userId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Authenticates the user and stores `data.access_token` as the collection's `accessToken`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', body.data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the authenticated principal currently attached by the JWT strategy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.userId) pm.collectionVariables.set('userId', body.data.userId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Application",
      "item": [
        {
          "name": "Get root",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "Returns the current Hello World response. This route is protected by the global JWT guard."
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Student\",\n  \"dateOfBirth\": \"2014-05-15T00:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('studentId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/students?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "Alex",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "id:DESC",
                  "disabled": true
                }
              ]
            },
            "description": "Returns only students visible through the current relationship/ownership query."
          }
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Update student",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alexandra\"\n}"
            },
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Authenticated self-service profile routes. The target user always comes from the bearer token; arbitrary user IDs are not accepted.",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"User\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Student assignments",
      "description": "These endpoints represent the currently implemented basic assignment CRUD. The current entity does not yet link assignments to students.",
      "item": [
        {
          "name": "Create assignment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Recital practice week\",\n  \"description\": \"Practice Amazing Grace and complete written theory.\",\n  \"start_date\": \"2026-08-17T00:00:00.000Z\",\n  \"end_date\": \"2026-08-23T23:59:59.000Z\"\n}"
            },
            "url": "{{baseUrl}}/student-assignments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('assignmentId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List assignments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-assignments"
          }
        },
        {
          "name": "Get assignment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Update assignment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated recital practice week\"\n}"
            },
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Delete assignment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/student-assignments/{{assignmentId}}"
          }
        }
      ]
    }
  ]
}
